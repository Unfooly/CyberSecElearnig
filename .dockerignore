# Zależności - instalowane od zera w każdym etapie builda (npm ci)
node_modules
**/node_modules

# Git
.git
.gitignore

# Sekrety - obrazy Dockera NIE mają nigdy zawierać .env; wartości
# produkcyjne trafiają do kontenera przez `env_file: .env` w
# docker-compose.prod.yml, na hoście, nigdy w warstwach obrazu.
.env
.env.*
!.env.example

# Build output - odtwarzane na nowo w kontenerze buildera
**/dist
**/.next
**/coverage
*.tsbuildinfo

# Treść modułów: do obrazów trafia wyłącznie JSON i kod pakietu, nigdy ilustracje/audio (te idą z CONTENT_BASE_URL).
# Archiwa i podglądy maskotki to materiał źródłowy, nie zasób aplikacji.
packages/content/mascot/*.zip
packages/content/mascot/preview.html
packages/content/assets
packages/content/**/*.mp3

# Dokumentacja / narzędzia deweloperskie niepotrzebne w kontekście builda
docs
.vscode
.idea
*.md
!README.md

# OS / logi
.DS_Store
Thumbs.db
npm-debug.log*
*.log
