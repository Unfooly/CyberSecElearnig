# Kopia zapasowa bazy (B-117, docs/ops/BACKUP.md). Skopiuj do .env.backup (NIE do repo - .gitignore), chmod 600.
# Na VPS wystarczą zmienne „wysyłka”; na komputerze z kluczem prywatnym (próba odtworzenia) - „odtworzenie”.

# --- wysyłka (VPS, scripts/ops/db-backup.sh) ---
# Klucz PUBLICZNY age (age1...). Klucz prywatny generujesz na swoim komputerze (runbook, krok 1) i NIGDY nie kładziesz na VPS.
BACKUP_AGE_RECIPIENT=
# Prywatny bucket na kopie z JURYSDYKCJĄ UE - INNY niż publiczny bucket treści (CONTENT_BASE_URL).
# Endpoint bucketu z jurysdykcją UE: https://<account-id>.eu.r2.cloudflarestorage.com (bez ".eu" - poza gwarancją UE).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# Token R2 ograniczony do tego bucketu (Object Read & Write). Umie też kasować - przed tym chroni blokada obiektów bucketu (Bucket Lock, 14 dni).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Obowiązkowo: adres pingu usługi alarmowej (np. healthchecks.io, okres 1 dzień, tolerancja 2 h); po błędzie skrypt woła <URL>/fail.
BACKUP_HEALTHCHECK_URL=

# --- odtworzenie (komputer właściciela, scripts/ops/db-restore-check.sh) ---
# Ścieżka do pliku z kluczem prywatnym age (zalecany zaszyfrowany hasłem: unfooly-backup.agekey.age).
BACKUP_AGE_IDENTITY=
# Osobny token TYLKO DO ODCZYTU tego bucketu.
BACKUP_S3_READ_ACCESS_KEY_ID=
BACKUP_S3_READ_SECRET_ACCESS_KEY=
