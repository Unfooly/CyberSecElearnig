# Skopiuj ten plik jako .env (nie commituj .env do gita)

# Baza danych - zgodna z docker-compose.yml
# Rola migracyjna (właściciel tabel, uprawnienia DDL) - używana tylko przez
# `prisma migrate`, nigdy przez runtime backendu. Patrz README "Dwie role
# Postgresa: migracje vs runtime".
DATABASE_URL="postgresql://cyberszkolo:cyberszkolo_dev@localhost:5432/cyberszkolo?schema=public"

# Hasło roli runtime backendu (cyberszkolo_app) - NIE superuser, NIE
# właściciel tabel, więc RLS (Zasada nr 1, CLAUDE.md) faktycznie ją ogranicza.
# Wygeneruj losowo przed pierwszym `docker compose up`, np.: openssl rand -hex 24
# To samo hasło musi pojawić się w DATABASE_URL_APP poniżej - docker-compose.yml
# przekazuje tę zmienną do skryptu, który tworzy rolę cyberszkolo_app.
APP_DB_PASSWORD="zmien-na-losowy-dlugi-ciag-znakow"

# Connection string dla runtime aplikacji (NestJS PrismaService) - jedyna
# rola, którą backend łączy się z bazą w normalnym działaniu.
DATABASE_URL_APP="postgresql://cyberszkolo_app:zmien-na-losowy-dlugi-ciag-znakow@localhost:5432/cyberszkolo?schema=public&connection_limit=10"

# Redis (kolejki BullMQ)
REDIS_URL="redis://localhost:6379"
# Symulacje phishingowe: domena nadawcy (OSOBNA od domeny głównej i od maili transakcyjnych).
# Klient edytuje tylko część lokalną adresu (np. hr@<ta domena>). Bez niej adres w UI jest niepełny.
# PHISHING_EMAIL_DOMAIN="test-ywj2lpn32xqg7oqz.mlsender.net"

# Zaufane proxy przed aplikacją (Cloudflare Tunnel). Lokalnie ZAWSZE false: nagłówki
# CF-Connecting-IP / X-Forwarded-For są wtedy ignorowane (nie da się podszyć IP).
TRUST_PROXY="false"

# Zadania w tle (BullMQ): domyślnie włączone poza NODE_ENV=test; "false" wyłącza.
# BACKGROUND_JOBS_ENABLED="true"
# JOBS_QUEUE_PREFIX="unfooly"
# Prefiks kluczy Redisa (limiter maili). Gdy Redis jest współdzielony między środowiskami,
# ustaw INNY prefiks w każdym (testy e2e czyszczą tylko własny, unikalny prefiks).
# REDIS_KEY_PREFIX="unfooly"

# Auth
JWT_SECRET="zmien-na-losowy-dlugi-ciag-znakow"
JWT_REFRESH_SECRET="inny-losowy-dlugi-ciag-znakow"

# Publiczny URL frontendu (apps/web) - używany przez backend WYŁĄCZNIE do
# budowania linków w mailach (np. reset hasła), nie do komunikacji
# request/response - to nigdy nie jest cel wywołania HTTP z apps/api.
FRONTEND_URL="http://localhost:3000"
# Adres, na który trafiają prośby o demo ze strony głównej (POST /demo-requests).
SALES_EMAIL=""

# E-mail transakcyjny (weryfikacja konta, reset hasla, zaproszenia) - MailerSend API
# (apps/api/src/email/). Brak/pusty token = EmailService loguje treść maila
# do konsoli zamiast wysyłać, patrz README. Uzupełnij po założeniu konta.
MAILERSEND_API_TOKEN=""
EMAIL_FROM="ustaw-adres-nadawcy@domena-z-mailersend"
EMAIL_FROM_NAME="Unfooly"

# E-mail do symulacji phishingowych - MUSI być osobna domena niż powyżej
PHISHING_EMAIL_DOMAIN="test-ywj2lpn32xqg7oqz.mlsender.net"
# TYLKO środowisko testowe z jedną domeną próbną MailerSend (ta sama dla maili transakcyjnych i symulacji): pozwala na
# NODE_ENV=production przy wspólnej domenie. Dokładnie ta wartość; na produkcji z prawdziwymi klientami NIE ustawiać.
# PHISHING_ALLOW_SHARED_TRANSACTIONAL_DOMAIN=yes-this-is-a-test-environment
# Transport wysyłki symulacji (osobny od EmailService): mailersend | smtp | log | none.
# Puste: poza produkcją "log" (nic nie wychodzi, tylko log podsumowania), na produkcji "none" (blokada).
PHISHING_MAIL_TRANSPORT=
# WŁASNY token MailerSend dla symulacji (token poczty transakcyjnej NIE jest używany).
PHISHING_MAILERSEND_API_TOKEN=
# Dla PHISHING_MAIL_TRANSPORT=smtp, np. smtp://localhost:1025 (Mailpit) albo smtps://user:haslo@host:465
PHISHING_SMTP_URL=
# Adres bazowy strony lądowania w linkach z maili (<baza>/t/<token>). Puste = FRONTEND_URL.
PHISHING_LANDING_BASE_URL=
# Migawka agregatów wyników symulacji (widok per dział, CSV agregatów, KPI) jest odświeżana nie częściej niż co tyle sekund
# (ograniczenie obserwacji zmian w czasie rzeczywistym; domyślnie 3600 = godzina, 0 = wyłączona, w NODE_ENV=test domyślnie 0).
# Nieprawidłowa wartość = 3600. Widok osobowy (audytowany) nie używa migawki.
# RESULTS_CACHE_TTL_SECONDS=3600

# Stripe (billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Tylko lokalnie: pozwala uruchomić NODE_ENV=production bez MAILERSEND_API_TOKEN
# (linki z maili trafiaja wtedy do logow kontenera). NIGDY na prawdziwej produkcji.
# ALLOW_EMAIL_DEV_MODE="true"
