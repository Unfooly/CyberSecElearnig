# Skopiuj ten plik jako .env (nie commituj .env do gita)

# Baza danych - zgodna z docker-compose.yml
# Rola migracyjna (właściciel tabel, uprawnienia DDL) - używana tylko przez
# `prisma migrate`, nigdy przez runtime backendu. Patrz README "Dwie role
# Postgresa: migracje vs runtime".
DATABASE_URL="postgresql://cyberszkolo:cyberszkolo_dev@localhost:5432/cyberszkolo?schema=public"

# Hasło roli runtime backendu (cyberszkolo_app) - NIE superuser, NIE
# właściciel tabel, więc RLS (Zasada nr 1, CLAUDE.md) faktycznie ją ogranicza.
# Wygeneruj losowo przed pierwszym `docker compose up`, np.: openssl rand -hex 24
# To samo hasło musi pojawić się w DATABASE_URL_APP poniżej - docker-compose.yml
# przekazuje tę zmienną do skryptu, który tworzy rolę cyberszkolo_app.
APP_DB_PASSWORD="zmien-na-losowy-dlugi-ciag-znakow"

# Connection string dla runtime aplikacji (NestJS PrismaService) - jedyna
# rola, którą backend łączy się z bazą w normalnym działaniu.
DATABASE_URL_APP="postgresql://cyberszkolo_app:zmien-na-losowy-dlugi-ciag-znakow@localhost:5432/cyberszkolo?schema=public"

# Redis (kolejki BullMQ)
REDIS_URL="redis://localhost:6379"
# Zadania w tle (BullMQ): domyślnie włączone poza NODE_ENV=test; "false" wyłącza.
# BACKGROUND_JOBS_ENABLED="true"
# JOBS_QUEUE_PREFIX="unfooly"

# Auth
JWT_SECRET="zmien-na-losowy-dlugi-ciag-znakow"
JWT_REFRESH_SECRET="inny-losowy-dlugi-ciag-znakow"

# Publiczny URL frontendu (apps/web) - używany przez backend WYŁĄCZNIE do
# budowania linków w mailach (np. reset hasła), nie do komunikacji
# request/response - to nigdy nie jest cel wywołania HTTP z apps/api.
FRONTEND_URL="http://localhost:3000"
# Adres, na który trafiają prośby o demo ze strony głównej (POST /demo-requests).
SALES_EMAIL=""

# E-mail transakcyjny (weryfikacja konta, reset hasla, zaproszenia) - MailerSend API
# (apps/api/src/email/). Brak/pusty token = EmailService loguje treść maila
# do konsoli zamiast wysyłać, patrz README. Uzupełnij po założeniu konta.
MAILERSEND_API_TOKEN=""
EMAIL_FROM="ustaw-adres-nadawcy@domena-z-mailersend"
EMAIL_FROM_NAME="Unfooly"

# E-mail do symulacji phishingowych - MUSI być osobna domena niż powyżej
PHISHING_EMAIL_DOMAIN="symulacje-wasza-domena.pl"

# Stripe (billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Tylko lokalnie: pozwala uruchomić NODE_ENV=production bez MAILERSEND_API_TOKEN
# (linki z maili trafiaja wtedy do logow kontenera). NIGDY na prawdziwej produkcji.
# ALLOW_EMAIL_DEV_MODE="true"
