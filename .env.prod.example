# Produkcja / VPS: JEDYNY plik konfiguracji na serwerze. Skopiuj jako `.env.prod`
# obok docker-compose.prod.yml (cp .env.prod.example .env.prod && chmod 600 .env.prod)
# i uzupełnij WSZYSTKIE wartości. Dev-owy `.env` NIE jest czytany na VPS.
#
# Ten sam plik jest używany dwa razy - dlatego KAŻDE polecenie compose ma go podawać:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml <polecenie>
#   1. --env-file .env.prod   -> interpolacja ${...} w docker-compose.prod.yml
#                                (IMAGE_TAG, TUNNEL_TOKEN, hasła Postgresa, profile),
#   2. env_file: ${ENV_FILE:-.env.prod} w compose -> zmienne środowiskowe kontenerów
#                                (FRONTEND_URL, JWT_*, DATABASE_URL*, MAILERSEND_* ...).
# Wygodnie raz na sesję: export COMPOSE_ENV_FILES=.env.prod COMPOSE_FILE=docker-compose.prod.yml
#
# Ten plik jest wzorem - nie zawiera żadnych prawdziwych sekretów. Nigdy nie
# commituj `.env.prod` (jest w .gitignore).
#
# env_file w Docker Compose NIE podstawia ${...} wewnątrz pliku - hasła Postgresa
# trzeba wpisać dosłownie w dwóch miejscach (osobna zmienna + connection string).
# Losowe sekrety: openssl rand -hex 32

# --- Compose ---------------------------------------------------------------
# Włącza usługę cloudflared (Cloudflare Tunnel). Alternatywa: "caddy" (klasyczny
# reverse proxy na 80/443, patrz Caddyfile). Nie ustawiaj obu naraz.
COMPOSE_PROFILES=tunnel

# Token tunelu z panelu Cloudflare Zero Trust (Networks -> Tunnels -> Twój
# tunel -> "Install and run" -> wartość po `--token`). To SEKRET: kto go ma,
# może podpiąć się pod Twój tunel. Public Hostname w panelu: Service = http://web:3000
TUNNEL_TOKEN=

# --- Obrazy z GHCR (budowane przez GitHub Actions, NIE na VPS) -------------------
# Tag obrazów api/web: latest (ostatni udany build z main) albo sha-<krótki hash>
# (np. sha-1a2b3c4) - do przypięcia wersji i wycofania. Patrz docs/deploy-test.md.
IMAGE_TAG=latest
# Prefiks nazw obrazów = ghcr.io/<właściciel repozytorium na GitHubie, małymi literami>/<nazwa repo>.
# Workflow buduje nazwę z github.repository_owner, więc tu wpisz TEN SAM właściciel (dziś
# organizacja Unfooly). Zmień po każdym przeniesieniu/zmianie nazwy repozytorium.
IMAGE_PREFIX=ghcr.io/unfooly/cybersecelearnig

# --- Środowisko ------------------------------------------------------------
NODE_ENV=production

# --- Baza danych (Postgres w compose, host = nazwa usługi `postgres`) -------
# Superuser / właściciel tabel, tworzony przez obraz postgres.
POSTGRES_PASSWORD=zmien-na-losowy-sekret
# Rola migracyjna (DDL) - używana TYLKO przez usługę `migrate` (prisma migrate deploy).
DATABASE_URL="postgresql://cyberszkolo:zmien-na-losowy-sekret@postgres:5432/cyberszkolo?schema=public"

# Rola runtime backendu (cyberszkolo_app) - NIE superuser, więc RLS faktycznie
# ją ogranicza (Zasada nr 1, CLAUDE.md). To samo hasło w obu linijkach poniżej.
APP_DB_PASSWORD=zmien-na-inny-losowy-sekret
DATABASE_URL_APP="postgresql://cyberszkolo_app:zmien-na-inny-losowy-sekret@postgres:5432/cyberszkolo?schema=public"

# --- Redis (kolejki BullMQ) --------------------------------------------------
REDIS_URL="redis://redis:6379"
# --- Symulacje phishingowe -----------------------------------------------------
# Domena nadawcy kampanii: OSOBNA od domeny głównej i od maili transakcyjnych (reputacja, regulamin
# dostawcy). Na produkcji własna, ZWERYFIKOWANA domena z SPF/DKIM/DMARC - warunek blokujący startu
# publicznego (docs/deploy-test.md, sekcja 9). Domena testowa MailerSend (*.mlsender.net) tylko na testowym.
# PHISHING_EMAIL_DOMAIN=""

# --- Proxy / adres klienta ---------------------------------------------------
# true = ruch dociera przez Cloudflare Tunnel: web (BFF) bierze prawdziwy adres klienta z
# nagłówka CF-Connecting-IP (fallback: pierwszy hop X-Forwarded-For) i przekazuje go do api,
# a limity żądań (throttler) liczą się PER KLIENT, nie per kontener web. Bez tego wszyscy
# użytkownicy dzielą jeden licznik. Ustaw "true" na produkcji z tunelem. Zostaw "false"
# (albo usuń) wszędzie tam, gdzie przed aplikacją NIE stoi zaufane proxy - wtedy nagłówki są
# ignorowane, bo inaczej każdy mógłby podszyć swoje IP i ominąć limity.
# WARUNEK BEZPIECZEŃSTWA: api NIE może mieć wystawionych portów (w docker-compose.prod.yml ich nie ma),
# a web musi być osiągalny wyłącznie przez tunel/proxy - inaczej nagłówek da się podrobić.
# Alternatywa z Caddy (profil "caddy"): Caddyfile sam nadpisuje CF-Connecting-IP prawdziwym adresem
# połączenia, więc "true" jest bezpieczne tylko z tym Caddyfile; przy innym proxy ustaw "false".
# Limity są liczone per adres IPv4 albo per sieć /64 dla IPv6.
TRUST_PROXY="true"

# Zadania w tle (worker BullMQ w procesie API, m.in. sprzątanie organizacji bez
# zweryfikowanej domeny). Domyślnie włączone; "false" wyłącza worker w tej instancji.
# BACKGROUND_JOBS_ENABLED="true"
# JOBS_QUEUE_PREFIX="unfooly"
# Prefiks kluczy Redisa innych niż kolejki (limiter maili rejestracji). Domyślnie "unfooly";
# zmień tylko przy współdzieleniu Redisa z inną instancją.
# REDIS_KEY_PREFIX="unfooly"

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=zmien-na-losowy-sekret-min-32-znaki
JWT_REFRESH_SECRET=zmien-na-inny-losowy-sekret-min-32-znaki

# --- Adresy -------------------------------------------------------------------
# apps/web woła apps/api przez wewnętrzną sieć compose (nie przez internet).
API_URL="http://api:3001"
# Publiczny adres aplikacji (ten sam co Public Hostname w Cloudflare), z https://.
# Trafia do linków w e-mailach i do metadanych strony (logo w mailach, OG).
FRONTEND_URL="https://app.twoja-domena.pl"
# Opcjonalnie, jeśli inny niż FRONTEND_URL (canonical / Open Graph strony głównej).
# SITE_URL="https://twoja-domena.pl"

# --- E-mail (MailerSend) ------------------------------------------------------
# Na produkcji token i adres nadawcy są WYMAGANE (bez nich api odmawia startu).
# Adres nadawcy musi być z zweryfikowanej domeny w MailerSend.
MAILERSEND_API_TOKEN=
EMAIL_FROM="no-reply@twoja-domena.pl"
EMAIL_FROM_NAME="Unfooly"
# Adres, na który trafiają prośby o demo ze strony głównej (POST /demo-requests).
SALES_EMAIL=
# Domena symulacji phishingowych - MUSI być osobna niż domena e-maili transakcyjnych.
PHISHING_EMAIL_DOMAIN="symulacje.twoja-domena.pl"
# TYLKO środowisko testowe z jedną domeną próbną MailerSend (np. PHISHING_EMAIL_DOMAIN=<ta sama co w EMAIL_FROM>): pozwala na
# wspólną domenę mimo NODE_ENV=production (token symulacji nadal musi być INNY - utwórz drugi token w MailerSend).
# Dokładnie ta wartość; na produkcji z prawdziwymi klientami NIE ustawiać.
# PHISHING_ALLOW_SHARED_TRANSACTIONAL_DOMAIN=yes-this-is-a-test-environment
# Transport symulacji: mailersend | smtp (na produkcji "log" jest zabroniony, puste = wysyłka zablokowana).
PHISHING_MAIL_TRANSPORT=mailersend
# WŁASNY token MailerSend dla symulacji - inny niż MAILERSEND_API_TOKEN.
PHISHING_MAILERSEND_API_TOKEN=
PHISHING_SMTP_URL=
# Strona lądowania symulacji - docelowo OSOBNA domena niż aplikacja (https://). Puste = FRONTEND_URL.
PHISHING_LANDING_BASE_URL=

# --- Płatności (uzupełnij, gdy funkcja będzie używana) --------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
