# Skopiuj jako .env.test — używane przez testy (jednostkowe i e2e) w apps/api.
# Wskazuje na osobną bazę na tym samym kontenerze postgres z docker-compose.yml,
# żeby testy nigdy nie dotykały danych deweloperskich z .env.

# Rola migracyjna - tylko dla `prisma migrate deploy`, patrz README.
DATABASE_URL="postgresql://cyberszkolo:cyberszkolo_dev@localhost:5432/cyberszkolo_test?schema=public"

# Rola runtime (cyberszkolo_app) - testy e2e uruchamiają prawdziwy
# AppModule/PrismaService, więc muszą łączyć się tą samą, ograniczoną rolą co
# produkcyjny backend, inaczej testy RLS nic by nie sprawdzały.
# UWAGA: dev i test dzielą jeden kontener/klaster Postgresa (docker-compose.yml),
# a rola jest obiektem na poziomie klastra (nie bazy) - to MUSI być to samo
# hasło co APP_DB_PASSWORD w .env, inaczej jedno z połączeń przestanie działać.
APP_DB_PASSWORD="zmien-na-losowy-dlugi-ciag-znakow"
DATABASE_URL_APP="postgresql://cyberszkolo_app:zmien-na-losowy-dlugi-ciag-znakow@localhost:5432/cyberszkolo_test?schema=public"
