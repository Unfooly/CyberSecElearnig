generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  TRIAL
  STARTER
  BUSINESS
  ENTERPRISE
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  DEPARTMENT_MANAGER
  EMPLOYEE
}

enum CourseCategory {
  PHISHING_SOCIAL_ENGINEERING
  EMAIL_SECURITY
  IT_HYGIENE
  INCIDENT_RESPONSE
  MALWARE
  GENERAL_AWARENESS
}

// UWAGA: ten enum nie jest podpięty do żadnej kolumny (Course.contentBlocks
// to Json, typ bloku w środku to zwykły string) - istnieje w Postgresie, ale
// nic go tam nie egzekwuje. Prawdziwe źródło prawdy o dozwolonych typach to
// apps/api/src/courses/content-block.types.ts (TypeScript union). Trzymane
// tu tylko jako dokumentacja/spójny słownik wartości.
enum ContentBlockType {
  VIDEO
  QUIZ
  BRANCHING_SCENARIO
  DRAG_AND_DROP
  // Renderowany WYŁĄCZNIE w sandboxowanym <iframe> na froncie - patrz
  // komentarz przy ContentBlockType w content-block.types.ts.
  EMBEDDED_HTML
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum UserStatus {
  ACTIVE
  INVITED
}

// Stan organizacji w modelu samoobsługowym. PENDING_DOMAIN_VERIFICATION =
// firma się zarejestrowała, ale nie potwierdziła jeszcze domeny e-maila admina
// rekordem DNS TXT (OrganizationDomain) - do tego czasu API blokuje wszystko
// poza ekranem weryfikacji i ustawieniami (guard fail-closed, osobny commit).
enum OrganizationStatus {
  PENDING_DOMAIN_VERIFICATION
  ACTIVE
}

enum LegalDocumentType {
  TERMS
  PRIVACY_POLICY
}

model Organization {
  id                      String             @id @default(cuid())
  // Nazwa wyświetlana podana przy rejestracji (NIE jest wyprowadzana z domeny
  // e-maila i NIE jest unikalna - o własności domeny rozstrzyga weryfikacja DNS).
  name                    String
  plan                    Plan               @default(TRIAL)
  seatsLimit              Int                @default(10)
  // Domyślnie PENDING_DOMAIN_VERIFICATION (fail-closed dla nowych organizacji).
  // Migracje ustawiły ACTIVE organizacjom istniejącym przed tym modelem (bez
  // weryfikacji domeny).
  status                  OrganizationStatus @default(PENDING_DOMAIN_VERIFICATION)
  // Zweryfikowana domena pozwala włączyć "pracownicy z adresem @domena mogą sami
  // dołączyć". Tu tylko przełącznik - sam przepływ dołączania to osobne zadanie.
  selfJoinEnabled         Boolean            @default(false)
  // Ranking pracowników organizacji (XP, przypięte osiągnięcia) - admin organizacji może go wyłączyć (X, część 3).
  leaderboardEnabled      Boolean            @default(true)
  // Ustawiane raz, gdy job sprzątania wysłał ostrzeżenie o usunięciu
  // niezweryfikowanej organizacji (po 7 dniach) - chroni przed duplikatami maila.
  unverifiedWarningSentAt DateTime?
  // Strefa czasowa organizacji (IANA, np. "Europe/Warsaw") - wg niej UI formatuje daty i godziny (jeden helper w apps/web,
  // niezależnie od strefy serwera i przeglądarki). Na teraz wszyscy mają domyślną wartość; edycja w ustawieniach.
  timezone                String             @default("Europe/Warsaw") @db.VarChar(64)
  createdAt               DateTime           @default(now())

  users                      User[]
  departments                Department[]
  courseAssignments          CourseAssignment[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  userBadges                 UserBadge[]
  domains                    OrganizationDomain[]
  billingDetails             OrganizationBillingDetails?
  legalAcceptances           LegalAcceptance[]
  refreshTokens              RefreshToken[]
  phishingTemplates          PhishingTemplate[]
  phishingTemplateEdits      PhishingTemplateEdit[]
  phishingCampaigns          PhishingCampaign[]
  phishingCampaignRecipients PhishingCampaignRecipient[]
  phishingResultSettings     PhishingResultSettings?
  phishingResultAudit        PhishingResultVisibilityAudit[]
  threatReports              ThreatReport[]
  threatReportEvents         ThreatReportEvent[]
  threatReportViews          ThreatReportView[]
  userImportBatches          UserImportBatch[]
  userImportRows             UserImportRow[]
  inviteNotices              InviteNotice[]
  pendingAdminClaims         PendingAdminClaim[]
  threatReportNotification   ThreatReportNotificationState?
  userAvatarImages           UserAvatarImage[]

  // Job sprzątania szuka organizacji PENDING starszych niż N dni.
  @@index([status, createdAt])
  @@map("organizations")
}

// Domena e-maila admina do weryfikacji rekordem DNS TXT:
//   _unfooly-verify.<domain> = "unfooly-verify=<verificationToken>"
// verificationToken NIE jest sekretem (wartość i tak trafia do publicznego DNS),
// ale jest losowy (nieodgadywalny).
//
// Unikalność domeny tylko wśród ZWERYFIKOWANYCH: partial unique index
// "organization_domains_domain_verified_key" (WHERE "verifiedAt" IS NOT NULL) -
// Prisma nie potrafi go wyrazić, więc żyje wyłącznie w migracji SQL. Kilka
// organizacji może czekać na tę samą domenę; wygrywa pierwsza zweryfikowana.
model OrganizationDomain {
  id                String    @id @default(cuid())
  organizationId    String
  // Znormalizowana: małe litery, punycode, bez końcowej kropki.
  domain            String
  verificationToken String
  verifiedAt        DateTime?
  // Ostatnie kliknięcie "Sprawdź teraz" - cooldown per organizacja.
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
  @@map("organization_domains")
}

// Dane do faktury (dane firmowe i osobowe). Osobna tabela zamiast kolumn na
// Organization: `organizations` jest globalna (bez RLS), a NIP i adres muszą
// podlegać Zasadzie nr 1 (organizationId + RLS + FORCE). Na start tylko PL:
// country jest stałe "PL" (CHECK w migracji), NIP z sumą kontrolną sprawdza
// aplikacja, kod pocztowy NN-NNN wymusza CHECK.
model OrganizationBillingDetails {
  id             String   @id @default(cuid())
  organizationId String   @unique
  legalName      String   @db.VarChar(255)
  // 10 cyfr, bez myślników.
  taxId          String   @db.VarChar(10)
  // Ulica i numer.
  addressLine    String   @db.VarChar(255)
  postalCode     String   @db.VarChar(6)
  city           String   @db.VarChar(120)
  country        String   @default("PL") @db.VarChar(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_billing_details")
}

// Dowód zgody (regulamin, polityka prywatności) z wersją dokumentu - przy
// zmianie treści da się wykazać, którą wersję kto zaakceptował. Świadomie bez
// adresu IP (dodatkowa dana osobowa).
model LegalAcceptance {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  documentType   LegalDocumentType
  // np. "draft-1" (do czasu dostarczenia treści prawnych).
  version        String            @db.VarChar(40)
  acceptedAt     DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Złożony FK: użytkownik musi należeć do TEJ SAMEJ organizacji (patrz migracja).
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, documentType, version])
  @@index([organizationId])
  @@map("legal_acceptances")
}

enum PhishingTemplateAction {
  CLONED
  UPDATED
  DELETED
}

// Szablon maila symulacji phishingowej. organizationId = NULL => szablon GLOBALNY (startowy zestaw,
// wstawiany migracją jako właściciel schematu); niepusty => własny szablon organizacji (klon/edycja).
// RLS ROZBITY NA KOMENDY (migracja): SELECT widzi "NULL lub moja organizacja", a INSERT/UPDATE/DELETE
// wyłącznie "moja organizacja" - rola aplikacji nie może zmienić ani usunąć szablonu globalnego
// (DELETE sprawdza tylko USING, dlatego USING dla DELETE/UPDATE nie zawiera "IS NULL").
// Treść HTML jest sanityzowana przy zapisie (allow-lista tagów; jedyny link to {{trackingLink}}).
model PhishingTemplate {
  id               String   @id @default(cuid())
  organizationId   String?
  // Stały klucz szablonu globalnego (np. "kurier"); null dla szablonów organizacji.
  key              String?  @unique
  name             String   @db.VarChar(120)
  subject          String   @db.VarChar(200)
  bodyHtml         String   @db.Text
  // Treść strony "To była symulacja" (lekcja) - sanityzowana, bez linków.
  lessonHtml       String   @db.Text
  // Nazwa wyświetlana nadawcy i część lokalna adresu; domena zawsze z PHISHING_EMAIL_DOMAIN.
  senderName       String   @db.VarChar(80)
  senderLocalPart  String   @db.VarChar(64)
  // Skąd sklonowano (globalny albo własny); luźne powiązanie, bez FK (szablon źródłowy może zniknąć).
  sourceTemplateId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Cel złożonego FK z phishing_template_edits (SQL-only, patrz migracja).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("phishing_templates")
}

// Audyt zmian szablonów organizacji (kto, kiedy, co). Wiersze przeżywają usunięcie szablonu
// i pracownika: templateId i actorUserId są zerowane (ON DELETE SET NULL (kolumna) - SQL-only
// złożone FK, patrz migracja), a nazwa szablonu i e-mail aktora to kopie z chwili zdarzenia.
model PhishingTemplateEdit {
  id             String                 @id @default(cuid())
  organizationId String
  templateId     String?
  templateName   String                 @db.VarChar(120)
  action         PhishingTemplateAction
  // Nazwy zmienionych pól (bez wartości - treść może być duża).
  changedFields  String[]
  actorUserId    String?
  actorEmail     String                 @db.VarChar(254)
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, templateId])
  @@map("phishing_template_edits")
}

enum PhishingCampaignStatus {
  // Zaplanowana: zadania wysyłki są w kolejce, żadna wiadomość jeszcze nie wyszła.
  SCHEDULED
  // Co najmniej jedna wiadomość została zajęta do wysyłki.
  RUNNING
  // Każdy odbiorca ma wynik końcowy (wysłano albo nieudane).
  COMPLETED
  // Anulowana przez ORG_ADMIN (zadania usunięte z kolejki, niewysłane => failedAt CANCELLED).
  CANCELLED
}

enum PhishingAudienceType {
  ALL
  DEPARTMENTS
  USERS
}

// Kampania jednorazowa. SNAPSHOT szablonu (temat, treść, nadawca) jest kopiowany do kampanii przy starcie:
// późniejsza edycja/usunięcie szablonu nie zmienia trwającej ani zakończonej kampanii. Usunięcie
// autora zeruje createdByUserId (SQL-only złożone FK ON DELETE SET NULL, patrz migracja); createdByEmail
// to kopia z chwili utworzenia (wpis w checkliście DPIA).
model PhishingCampaign {
  id              String                 @id @default(cuid())
  organizationId  String
  name            String                 @db.VarChar(120)
  status          PhishingCampaignStatus @default(SCHEDULED)
  audienceType    PhishingAudienceType
  // Skąd wzięto szablon (luźne powiązanie, bez FK).
  templateId      String?
  templateName    String                 @db.VarChar(120)
  subject         String                 @db.VarChar(200)
  bodyHtml        String                 @db.Text
  lessonHtml      String                 @db.Text
  senderName      String                 @db.VarChar(80)
  senderLocalPart String                 @db.VarChar(64)
  windowStart     DateTime
  windowEnd       DateTime
  createdByUserId String?
  createdByEmail  String                 @db.VarChar(254)
  createdAt       DateTime               @default(now())
  cancelledAt     DateTime?
  completedAt     DateTime?

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   PhishingCampaignRecipient[]

  // Cel złożonego FK z odbiorców: odbiorca musi należeć do kampanii TEJ SAMEJ organizacji.
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([status, windowEnd])
  @@map("phishing_campaigns")
}

// Odbiorca kampanii = jedna zaplanowana wiadomość. Stan wysyłki (at-most-once):
//   nowy -> claimedAt (atomowe zajęcie, tokenHash) -> sentAt (dostawca przyjął) | failedAt+failureCode.
// Nie ma stanu "zajęty" po restarcie: zajęcie starsze niż limit i bez wyniku jest domykane jako
// INTERRUPTED_UNKNOWN (niepewne - dostawca mógł wysłać). Wiersz przeżywa usunięcie pracownika:
// userId zerowane (SQL-only złożone FK ON DELETE SET NULL ("userId")), nazwa działu to snapshot.
// Adresu e-mail NIE kopiujemy - wysyłka czyta go z konta pracownika w chwili wysyłki.
model PhishingCampaignRecipient {
  id                String    @id @default(cuid())
  organizationId    String
  campaignId        String
  userId            String?
  departmentId      String?
  departmentName    String?   @db.VarChar(255)
  scheduledAt       DateTime
  claimedAt         DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  // Kod bez danych osobowych (HTTP_422, TIMEOUT_UNKNOWN, CANCELLED, WINDOW_EXPIRED...).
  failureCode       String?   @db.VarChar(40)
  sendAttempts      Int       @default(0)
  // Pierwsze wejście na stronę lądowania (POST /t/:token/view z JS strony, NIE samo pobranie strony - skanery
  // linków) i pierwsze wysłanie formularza (POST /t/:token/submit). Wartości z formularza nie są nigdzie zapisywane.
  clickedAt         DateTime?
  submittedAt       DateTime?
  // Pierwsze zgłoszenie tej wiadomości jako podejrzanej przez adresata (moduł zgłoszeń); ustawiane RAZ (atomowo,
  // warunek reportedAt IS NULL). Raport po kliknięciu = clickedAt < reportedAt.
  reportedAt        DateTime?
  providerMessageId String?   @db.VarChar(200)
  // SHA-256 tokenu z linku (sam token istnieje tylko w mailu); ustawiany przy zajęciu.
  tokenHash         String?   @unique
  createdAt         DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     PhishingCampaign @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  // Jeden e-mail na osobę w kampanii (wiele wierszy z userId NULL po usunięciu pracowników jest dozwolone).
  @@unique([campaignId, userId])
  // Cel złożonego FK z threat_reports (zgłoszenie dopasowane do odbiorcy tej samej organizacji).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([campaignId])
  @@index([scheduledAt])
  @@map("phishing_campaign_recipients")
}

enum PhishingVisibilityAction {
  // Włączenie wyników osobowych (wymaga uzasadnienia) i wyłączenie.
  ENABLED
  DISABLED
  // Wgląd w wyniki osobowe kampanii i ich eksport CSV (każdy wgląd zostawia ślad).
  VIEWED
  EXPORTED
}

// Ustawienia wyników symulacji organizacji. Wyniki OSOBOWE (kto kliknął) są domyślnie NIEDOSTĘPNE: dostępne wyłącznie
// dla ORG_ADMIN po jawnym włączeniu z uzasadnieniem (min. 20 znaków). Flaga jest czytana z bazy na KAŻDYM żądaniu o
// dane osobowe (nigdy z JWT ani cache). Tabela z RLS - dane firmowe nie trafiają do `organizations`.
model PhishingResultSettings {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  personalResultsEnabled Boolean  @default(false)
  // Uzasadnienie ostatniego włączenia (wymagane; CHECK w migracji).
  justification          String?  @db.VarChar(500)
  changedByEmail         String   @db.VarChar(254)
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("phishing_result_settings")
}

// Dziennik dostępu do wyników osobowych: włączenia/wyłączenia (z uzasadnieniem), każdy wgląd i eksport. Tylko dopisywanie
// (REVOKE UPDATE, DELETE dla roli aplikacji). actorUserId zerowane po usunięciu konta (SQL-only złożone FK
// ON DELETE SET NULL), a actorEmail to kopia z chwili zdarzenia (wpis w checkliście DPIA).
model PhishingResultVisibilityAudit {
  id             String                   @id @default(cuid())
  organizationId String
  action         PhishingVisibilityAction
  justification  String?                  @db.VarChar(500)
  // Kampania, której dotyczył wgląd/eksport (luźne powiązanie, bez FK - kampania może zniknąć).
  campaignId     String?
  // Zakres wglądu/eksportu (ALL/PROBLEMS/CLICKED/SUBMITTED) i liczba zwróconych osób - widać, co dokładnie zostało pokazane.
  filter         String?                  @db.VarChar(20)
  rowCount       Int?
  actorUserId    String?
  actorEmail     String                   @db.VarChar(254)
  createdAt      DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("phishing_result_visibility_audit")
}

enum ThreatReportKind {
  // Zgłoszenie dopasowane do naszej symulacji: NIE trafia do skrzynki zgłoszeń admina, liczy się tylko w statystykach.
  SIMULATION
  // Prawdziwe zgłoszenie podejrzanej wiadomości (do skrzynki zgłoszeń).
  REAL
}

enum ThreatReportStatus {
  NEW
  IN_REVIEW
  THREAT
  SAFE
}

enum ThreatReportMatchMethod {
  // W wklejonym tekście był link śledzący należący do WŁASNEGO wiersza odbiorcy zgłaszającego (jednoznaczne).
  TOKEN
  // Dokładny nadawca (część lokalna + PHISHING_EMAIL_DOMAIN) ORAZ znormalizowany temat kampanii zgłaszającego.
  SENDER_SUBJECT
}

// Zgłoszenie podejrzanej wiadomości przez pracownika. Treść (body, headers, comment) trafia do bazy WYŁĄCZNIE dla
// zgłoszeń prawdziwych (CHECK w migracji): zgłoszenie dopasowane do symulacji zachowuje tylko temat, nadawcę i
// powiązanie z odbiorcą kampanii. Treść prawdziwych zgłoszeń jest czyszczona po 90 dniach (ThreatReportRetentionService;
// wpis w checkliście DPIA). Linki śledzące /t/<token> są maskowane przy zapisie (token cudzego odbiorcy nie może
// wyciec do skrzynki zgłoszeń). Usunięcie konta zeruje reporterUserId, dział i odbiorca to SQL-only złożone FK
// ON DELETE SET NULL (patrz migracja).
model ThreatReport {
  id                   String                   @id @default(cuid())
  organizationId       String
  reporterUserId       String?
  // Dział zgłaszającego w chwili zgłoszenia (zakres kierownika działu); luźny snapshot + złożone FK w SQL.
  reporterDepartmentId String?
  kind                 ThreatReportKind
  status               ThreatReportStatus       @default(NEW)
  // Nadawca i temat tak, jak je wpisał pracownik (tekst, bez znaków sterujących). Po 90 dniach retencja czyści je w
  // zgłoszeniach prawdziwych (null); zostaje wyłącznie senderDomain (statystyki "najczęstsze domeny nadawców").
  senderText           String?                  @db.VarChar(320)
  subject              String?                  @db.VarChar(300)
  // Domena adresu nadawcy (małe litery); null, gdy pracownik nie podał adresu. Nie jest czyszczona retencją.
  senderDomain         String?                  @db.VarChar(255)
  body                 String?                  @db.Text
  headers              String?                  @db.Text
  comment              String?                  @db.VarChar(1000)
  matchedRecipientId   String?
  matchMethod          ThreatReportMatchMethod?
  // Kiedy treść została usunięta (retencja); null = treść (jeśli jest) nadal w bazie.
  contentPurgedAt      DateTime?
  // Kiedy zgłoszenie zostało ujęte w powiadomieniu mailowym dla adminów (zbiorczym, max 1 mail / 15 min na organizację);
  // null = jeszcze nie powiadomiono. Zajmowane atomowo przez ThreatReportNotificationService.
  notifiedAt           DateTime?
  createdAt            DateTime                 @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       ThreatReportEvent[]
  views        ThreatReportView[]

  // Cel złożonego FK z threat_report_events (zdarzenie tej samej organizacji co zgłoszenie).
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, reporterUserId, createdAt])
  @@index([organizationId, kind, status])
  @@index([organizationId, kind, notifiedAt])
  @@map("threat_reports")
}

enum ThreatReportEventType {
  STATUS_CHANGED
  NOTE_ADDED
}

// Dziennik zgłoszenia: zmiany statusu i notatki adminów (kto, kiedy, co). Tylko dopisywanie dla roli aplikacji
// (REVOKE UPDATE, DELETE; jedyny wyjątek to UPDATE kolumny `note`, żeby retencja mogła wyczyścić treść notatek razem z
// treścią zgłoszenia po 90 dniach - samo zdarzenie i jego autor zostają). actorUserId zerowane po usunięciu konta
// (SQL-only złożone FK ON DELETE SET NULL), actorEmail to kopia z chwili zdarzenia (wpis w checkliście DPIA).
model ThreatReportEvent {
  id             String                @id @default(cuid())
  organizationId String
  reportId       String
  type           ThreatReportEventType
  fromStatus     ThreatReportStatus?
  toStatus       ThreatReportStatus?
  // Treść notatki (czysty tekst, tokeny linków maskowane); null po retencji albo dla zmiany statusu.
  note           String?               @db.VarChar(1000)
  actorUserId    String?
  actorEmail     String                @db.VarChar(254)
  createdAt      DateTime              @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       ThreatReport @relation(fields: [organizationId, reportId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId, reportId, createdAt])
  @@map("threat_report_events")
}

// Dziennik wglądów ORG_ADMIN w szczegóły zgłoszenia (treść, nagłówki, komentarz, zgłaszający): kto i kiedy - tak jak wgląd w
// wyniki osobowe symulacji (decyzja właściciela produktu 2026-09-20). Wpis powstaje w tej samej transakcji co odczyt. Tylko
// dopisywanie dla roli aplikacji (REVOKE UPDATE, DELETE). actorUserId zerowane po usunięciu konta, actorEmail to kopia z chwili wglądu.
model ThreatReportView {
  id             String   @id @default(cuid())
  organizationId String
  reportId       String
  actorUserId    String?
  actorEmail     String   @db.VarChar(254)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       ThreatReport @relation(fields: [organizationId, reportId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId, reportId, createdAt])
  @@map("threat_report_views")
}

// Import pracowników z CSV, krok 1 (podgląd): plik jest w całości rozebrany na wiersze i zwalidowany PRZED jakimkolwiek
// zapisem kont; partia trzyma wynik walidacji, żeby krok potwierdzenia (commit 5/5) pracował na tym, co użytkownik zobaczył.
// Partia w statusie PREVIEW wygasa po 24 h (job sprzątania kasuje ją razem z wierszami); na organizację jest jedna aktywna
// partia podglądu (nowy podgląd zastępuje poprzedni). Wiersze zawierają adresy e-mail i imiona pracowników - wpis w
// checkliście prywatności. Usunięcie autora zeruje createdByUserId (SQL-only złożone FK ON DELETE SET NULL), createdByEmail to kopia.
enum UserImportBatchStatus {
  // Podgląd po walidacji, nic nie zapisano w users (ważny 24 h).
  PREVIEW
  // Potwierdzony: konta utworzone, zaproszenia idą w kolejce z tempem (limit dobowy organizacji).
  PROCESSING
  // Wszystkie zaproszenia rozstrzygnięte (wysłane, nieudane albo pominięte); raport dostępny do wygaśnięcia partii.
  COMPLETED
}

// Wynik utworzenia konta dla wiersza VALID przy potwierdzeniu.
enum UserImportAccountResult {
  CREATED
  // Np. adres zajęty w innej organizacji (ogólny powód, bez ujawniania) - nie zużywa licencji.
  FAILED
}

// Stan zaproszenia mailowego utworzonego konta (kolejka z tempem).
enum UserImportInviteStatus {
  PENDING
  // Wysyłka WŁAŚNIE trwa (zajęcie tuż przed wysyłką, at-most-once): zajęcie bez wyniku po awarii procesu jest domykane jako
  // UNCERTAIN (INTERRUPTED_UNKNOWN), nigdy ponawiane po cichu.
  SENDING
  SENT
  // PEWNE niepowodzenie (dostawca odrzucił wiadomość albo nie było połączenia): nic nie wyszło.
  FAILED
  // NIEPEWNY wynik (timeout, HTTP 5xx, zerwane połączenie, przerwanie przez awarię): wiadomość MOGŁA dotrzeć. Jak RESULT_UNKNOWN
  // w wysyłce kampanii: nie ponawiamy i blokujemy "Wyślij zaproszenie ponownie" dla tego konta.
  UNCERTAIN
  // Pominięte: konto już aktywne/usunięte albo wysyłka zatrzymana przez administratora.
  SKIPPED
  // Zaproszenie wygasło: konto INVITED nie zostało aktywowane w 30 dni albo adres przejęła organizacja ze zweryfikowaną domeną
  // tego adresu (powód dla administratora jest ogólny - nie mówi, kto przejął adres).
  EXPIRED
}

enum UserImportRowStatus {
  // Poprawny, nowy adres: kandydat do utworzenia konta w kroku potwierdzenia.
  VALID
  // Adres ma już konto W TEJ organizacji: pomijamy, nic nie nadpisujemy.
  EXISTING
  // Błąd walidacji (powód w `reason`): wiersz nie zostanie zapisany.
  ERROR
}

model UserImportBatch {
  id              String                @id @default(cuid())
  organizationId  String
  createdByUserId String?
  createdByEmail  String                @db.VarChar(254)
  status          UserImportBatchStatus @default(PREVIEW)
  // Nazwa pliku do wyświetlenia (oczyszczona, bez ścieżki).
  fileName        String?               @db.VarChar(200)
  // Wykryty separator: "," ";" albo tabulator.
  delimiter       String                @db.VarChar(1)
  // Niepuste wiersze danych = validCount + existingCount + errorCount (CHECK w migracji).
  totalRows       Int
  validCount      Int
  existingCount   Int
  errorCount      Int
  // Puste wiersze pominięte po cichu.
  skippedEmpty    Int
  // Kolumny z nagłówka niepasujące do żadnego pola (ignorowane).
  ignoredColumns  String[]
  createdAt       DateTime              @default(now())
  // PREVIEW: koniec ważności podglądu (24 h). Po potwierdzeniu: górna granica przetwarzania (60 dni), a po zakończeniu
  // ostatnia chwila dostępności raportu (30 dni); po niej job sprzątania kasuje partię z wierszami (dane osobowe z pliku).
  expiresAt       DateTime
  confirmedAt     DateTime?
  confirmedByEmail String?              @db.VarChar(254)
  completedAt     DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rows         UserImportRow[]

  // Cel złożonego FK z user_import_rows (wiersz tej samej organizacji co partia).
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("user_import_batches")
}

model UserImportRow {
  id             String              @id @default(cuid())
  organizationId String
  batchId        String
  // Numer wiersza w pliku (1 = nagłówek).
  line           Int
  email          String              @db.VarChar(254)
  firstName      String              @db.VarChar(100)
  lastName       String              @db.VarChar(100)
  departmentName String?             @db.VarChar(100)
  status         UserImportRowStatus
  reason         String?             @db.VarChar(200)
  // Po potwierdzeniu (tylko wiersze VALID): wynik utworzenia konta i stan zaproszenia. userId to konto utworzone przez import
  // (luźne powiązanie + SQL-only złożone FK ON DELETE SET NULL); zerowane po usunięciu konta.
  accountResult  UserImportAccountResult?
  accountReason  String?             @db.VarChar(200)
  userId         String?
  inviteStatus   UserImportInviteStatus?
  inviteReason   String?             @db.VarChar(200)
  // Rezerwacja pojemności przez bieg kolejki (znacznik `now` biegu; wiersz zostaje PENDING) - liczy się do tempa (okno biegu).
  inviteClaimedAt DateTime?
  // Początek wysyłki TEGO zaproszenia (zajęcie PENDING -> SENDING tuż przed wysyłką). Wiek tego znacznika to czas jednej wysyłki:
  // zajęcie bez wyniku, starsze niż próg, oznacza awarię procesu (wynik niepewny), a nie wolny bieg.
  inviteSendingAt DateTime?
  inviteSentAt   DateTime?
  // WEWNĘTRZNE, nigdy w odpowiedziach API, raporcie ani licznikach: adres miał w chwili potwierdzenia konto w INNEJ organizacji, więc
  // konta nie utworzono (userId puste), a kolejka zamiast zaproszenia wyśle właścicielowi adresu informację "ktoś próbował Cię dodać".
  // Dla administratora wiersz wygląda jak każdy inny (konto utworzone, zaproszenie wysłane) - brak sondy istnienia kont.
  addressTaken   Boolean             @default(false)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batch        UserImportBatch @relation(fields: [organizationId, batchId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([batchId, line])
  @@index([organizationId, batchId, status])
  @@index([organizationId, batchId, inviteStatus])
  @@map("user_import_rows")
}

// Rejestracja organizacji na adres, który ma nieaktywowane zaproszenie w obcej organizacji: organizacja (PENDING) powstaje od razu,
// ale jej administrator dopiero po KLIKNIĘCIU linku z maila (potwierdzenie skrzynki). Do tego czasu zaproszenie i rejestracja
// współistnieją (users.email jest unikalny, więc konto admina nie może jeszcze powstać); kliknięcie przejmuje adres (zaproszenie wygasa)
// i tworzy admina. Bez kliknięcia w 24 h nic się nie dzieje (wpis wygasa, organizację PENDING sprząta zwykły job). Token ma postać
// "<organizationId>.<64 znaki hex>": organizacja jest znana bez omijania RLS, w bazie tylko hash.
model PendingAdminClaim {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @db.VarChar(254)
  firstName      String   @db.VarChar(100)
  lastName       String   @db.VarChar(100)
  // Wersja dokumentów prawnych zaakceptowanych w formularzu (zgody zapisujemy przy tworzeniu admina).
  legalVersion   String   @db.VarChar(64)
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("pending_admin_claims")
}

// Dziennik wiadomości "ktoś próbował dodać Cię do organizacji" (adres z kontem w INNEJ organizacji). Bez adresu i danych osobowych -
// tylko organizacja i czas. Liczy się do dobowego limitu zaproszeń organizacji na równi z tokenami zaproszeń, więc ukrycie faktu
// istnienia konta (odpowiedź jak dla nowego adresu) nie otwiera nielimitowanego kanału sondowania.
model InviteNotice {
  id             String   @id @default(cuid())
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("invite_notices")
}

// Stan powiadomień organizacji: kiedy wysłano ostatni mail zbiorczy (okno 15 minut). Jeden wiersz na organizację.
model ThreatReportNotificationState {
  id             String   @id @default(cuid())
  organizationId String   @unique
  lastSentAt     DateTime
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("threat_report_notification_state")
}

// Sesje: refresh tokeny przechowywane jako HASH (SHA-256 całego tokenu JWT), nigdy jawnie.
// Każdy login tworzy "rodzinę" (familyId); /auth/refresh rotuje token w obrębie rodziny.
// Użycie tokenu już wykorzystanego (poza oknem łaski) = reuse => unieważnienie CAŁEJ rodziny.
// RLS jak inne tabele z organizationId (migracja); odczyt po tokenHash przed poznaniem
// organizacji idzie wąską furtką TenantPrismaService.runRefreshTokenLookup (USING-only).
model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  familyId       String
  tokenHash      String    @unique
  expiresAt      DateTime
  // Ustawiane przy rotacji (token został wymieniony na następny).
  usedAt         DateTime?
  // Ustawiane przy wylogowaniu / reuse / "wyloguj wszędzie" / resecie hasła.
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Złożony FK: użytkownik musi należeć do TEJ SAMEJ organizacji (patrz migracja).
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Department {
  id             String @id @default(cuid())
  organizationId String

  name String @db.VarChar(255)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  // Umożliwia bezpieczny upsert przy imporcie CSV (find-or-create działu po
  // nazwie w obrębie organizacji) i jest sensowną gwarancją jakości danych -
  // patrz UsersService.importCsv.
  @@unique([organizationId, name])
  // Cel dodatkowego złożonego FK users(organizationId, departmentId) - patrz
  // komentarz przy User.department.
  @@unique([organizationId, id])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id                String     @id @default(cuid())
  organizationId    String
  email             String     @unique
  passwordHash      String
  role              Role       @default(EMPLOYEE)
  // ACTIVE = zarejestrowany sam / hasło ustawione. INVITED = utworzony przez
  // UsersService.inviteUser/importCsv, czeka na ustawienie pierwszego hasła.
  // AuthService.resetPassword przełącza INVITED -> ACTIVE przy pierwszym
  // udanym użyciu tokenu (ten sam PasswordResetToken co "zapomniałem hasła").
  status            UserStatus @default(ACTIVE)
  // null = adres niepotwierdzony (logowanie zablokowane). Ustawiane przez
  // AuthService.verifyEmail albo resetPassword (klik w link z maila).
  emailVerifiedAt   DateTime?
  departmentId      String?
  // Nullable - userzy sprzed modułu grywalizacji nie mają tych danych;
  // leaderboard (GamificationService) spada wtedy na inicjały z e-maila.
  firstName         String?
  lastName          String?
  // Preset (slug z GamificationService.AVATAR_PRESETS) albo zwalidowany URL
  // http(s) - walidacja w UsersService.updateAvatar, nie w samym DTO (patrz
  // komentarz przy UpdateAvatarDto).
  avatarUrl         String?
  // Ustawienie konta: lektor (narracja audio) w odtwarzaczu szkoleń. Zmieniane wyłącznie przez użytkownika dla SIEBIE
  // (PATCH /users/me/preferences); domyślnie włączony.
  narrationEnabled  Boolean    @default(true)
  // Ustawienie dostępności (WCAG 2.2.1, D-124): bez limitów czasu w rozmowie na żywo (LIVE_CALL) - serwer nie przyjmuje ciszy po
  // upływie limitu, odtwarzacz nie odlicza. Zmieniane wyłącznie przez użytkownika dla SIEBIE (PATCH /users/me/preferences).
  noTimeLimits      Boolean    @default(false)
  xp                Int        @default(0)
  level             Int        @default(1)
  // Wersja zasad, dla której przeszło już przyznanie wsteczne osiągnięć (D-111, GamificationService.syncAchievements).
  achievementsSyncVersion Int @default(0)
  // Przypięte osiągnięcia (X, część 3): kody z katalogu `badges`, maks. 3, kolejność = kolejność przypięcia/ułożenia.
  // Zapisuje WYŁĄCZNIE GamificationService.setPinnedAchievements (tylko zdobyte, bez duplikatów).
  pinnedAchievements String[] @default([])
  // Ustawiane WYŁĄCZNIE przez "wyloguj wszędzie" i reset hasła (SessionsService):
  // access tokeny wydane wcześniej są odrzucane (guard), a refresh tokeny unieważnione.
  // Źródło prawdy; odbicie z TTL w Redisie służy tylko szybkiemu sprawdzeniu w guardzie.
  sessionsRevokedAt DateTime?
  createdAt         DateTime   @default(now())

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Prisma modeluje tu zwykły FK (departmentId -> departments.id, SET NULL).
  // Dodatkowo migracja 20260919130000_user_department_same_organization dodała
  // złożony FK users_organizationId_departmentId_fkey (NO ACTION), który
  // wymusza, że dział należy do TEJ SAMEJ organizacji - Prisma nie potrafi go
  // wyrazić (opcjonalna kolumna w złożonej relacji), więc istnieje tylko w SQL.
  // NIE usuwaj go przy generowaniu kolejnych migracji (`migrate dev`).
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  courseAssignments       CourseAssignment[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  unlockedBadges          UserBadge[]
  legalAcceptances        LegalAcceptance[]
  refreshTokens           RefreshToken[]
  avatarImage             UserAvatarImage?

  // Cel złożonego FK z LegalAcceptance (użytkownik tej samej organizacji).
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([departmentId])
  @@map("users")
}

/// Ranga osiągnięcia (X, D-111) - etykieta w UI po angielsku (Secret / Legendary / Milestone).
enum AchievementRank {
  SECRET
  LEGENDARY
  MILESTONE
  // Moduł 2 (D-124): rzadkie osiągnięcia za wyróżniające się rozwiązanie jednego zadania.
  RARE
}

/// Zakres osiągnięcia: jeden moduł (`moduleSlug`) albo całe szkolenia (dowolny kurs).
enum AchievementScope {
  MODULE
  GLOBAL
}

/// Globalny katalog osiągnięć (dawniej „odznak”, D-111). Wpisy tworzy migracja (nie seed - seed nie jest częścią wdrożenia),
/// warunek przyznania żyje w kodzie (GamificationService, po `code`), tu tylko opis do UI.
model Badge {
  // uuid (nie cuid jak reszta modeli) - tak wskazuje specyfikacja tego
  // modułu; nie ujednolicam z resztą schematu bez pytania.
  id            String            @id @default(uuid())
  code          String            @unique
  // Nazwa po angielsku (jak na grafice), opis i warunek po polsku.
  title         String
  description   String
  // Plik trofeum w apps/web/public/achievements (zdobyte / zablokowane).
  icon          String
  lockedIcon    String?
  xpReward      Int               @default(50)
  rank          AchievementRank?
  // Tajne: przed zdobyciem API nie wydaje nazwy, opisu, warunku ani grafiki zdobytej („???”).
  hidden        Boolean           @default(false)
  scope         AchievementScope  @default(GLOBAL)
  moduleSlug    String?
  conditionText String?
  sortOrder     Int               @default(0)
  // Wycofane (stare odznaki sprzed D-111): znikają z UI, zdobyte wiersze i XP zostają.
  retiredAt     DateTime?
  createdAt     DateTime          @default(now())

  unlockedBy UserBadge[]

  @@map("badges")
}

/// Własny avatar wgrany przez użytkownika (D-067, zgłoszenie B-075). Osobna tabela,
/// żeby bajty obrazka nie ładowały się przy każdym zapytaniu o użytkownika.
/// Zapisujemy WYŁĄCZNIE wynik ponownego zakodowania po stronie API (256x256, bez
/// metadanych EXIF), nigdy pliku przysłanego przez klienta.
model UserAvatarImage {
  // Jeden avatar na użytkownika - userId jest kluczem głównym (zapis to upsert).
  userId         String   @id
  organizationId String
  mimeType       String   @db.VarChar(32)
  bytes          Bytes
  /// Skrót treści (16 znaków hex = 8 bajtów sha256) - trafia do `users.avatarUrl` jako `upload:<hash>` i do adresu
  /// obrazka, żeby po zmianie avatara przeglądarka nie pokazywała starego z cache.
  hash           String   @db.VarChar(16)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("user_avatar_images")
}

model UserBadge {
  id             String   @id @default(uuid())
  userId         String
  badgeId        String
  organizationId String
  unlockedAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge        Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_badges")
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  // Hash SHA-256 surowego tokenu (nigdy nie zapisujemy tokenu w czystej
  // postaci) - w przeciwieństwie do haseł token ma z góry 256 bitów
  // entropii, więc nie potrzebuje wolnego hashu jak bcrypt; szybki hash z
  // dokładnym dopasowaniem po indeksie wystarcza i jest jedynym sposobem na
  // odnalezienie rekordu przez `findUnique` (bcrypt z losową solą tego nie
  // umożliwia).
  tokenHash      String    @unique
  expiresAt      DateTime
  // null = nieużyty. Ustawiane raz, przy pierwszym udanym resecie - drugie
  // użycie tego samego tokenu musi się nie udać (patrz auth.service.ts).
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  // Hash SHA-256 surowego tokenu (jak PasswordResetToken) - surowy token
  // istnieje tylko w mailu.
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("email_verification_tokens")
}

model Course {
  id              String         @id @default(cuid())
  // Stabilny klucz treści importowanej z packages/content (module.json `slug`); NULL dla kursów tworzonych wprost
  // (testy, kursy sprzed silnika) - import robi po nim upsert (content-import, PR 4).
  slug            String?        @unique @db.VarChar(64)
  title           String
  // schemaVersion 4 (packages/content), dotąd walidowane przy imporcie, ale nigdzie nie zapisywane (B-087) - do karty
  // kursu/katalogu i SUMMARY "Czego się nauczyłeś"; wypełniane wyłącznie przez content-import.
  subtitle        String?        @db.VarChar(300)
  // 'basic' | 'intermediate' | 'advanced' (packages/content MODULE_LEVELS) - string, nie enum Prisma: zbiór wartości
  // pochodzi z pakietu treści, dodanie kolejnego poziomu nie powinno wymagać migracji bazy.
  level           String?        @db.VarChar(20)
  category        CourseCategory
  durationMinutes Int
  mandatory       Boolean        @default(false)
  // Cele szkolenia (lista tekstów, packages/content), do SUMMARY "Czego się nauczyłeś" - opcjonalne.
  objectives      Json?
  // Miniatura 16:9 do katalogu i karty kursu (D-084): ścieżka zasobu modułu (klucz w magazynie treści, jak obrazy bloków),
  // wypełniana wyłącznie przez content-import. NULL = karta bez miniatury (ikona kategorii).
  thumbnail       String?        @db.VarChar(300)
  // Uporządkowana lista bloków treści (VIDEO/QUIZ/BRANCHING_SCENARIO/
  // DRAG_AND_DROP) - patrz docs/content-backlog-elearning.md. Dla QUIZ i
  // BRANCHING_SCENARIO każda opcja niesie poprawność (`correct: boolean`
  // albo, zgodnie z przykładem w docs, `outcome: "correct" | "wrong"`) -
  // backend porównuje z tym wybór usera, nigdy nie ufa ocenie z klienta.
  // Od silnika scen (packages/content) to KOPIA treści NAJNOWSZEJ wersji (import ją odświeża) - źródłem prawdy dla
  // przypisania jest przypięta CourseVersion. Kursy sprzed silnika (tworzone wprost) dostają wersję 1 leniwie (CoursesService).
  contentBlocks   Json
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  assignments CourseAssignment[]
  versions    CourseVersion[]

  @@map("courses")
}

// Niemutowalna wersja treści kursu. Globalna jak `courses` (katalog treści, nie dane klienta: brak organizationId i RLS).
// Zmiana treści = NOWA wersja; przypisania w trakcie zostają na swojej (CourseAssignment.courseVersionId), więc pracownikowi
// nie przesuwają się bloki pod nogami. Wpisy tworzy wyłącznie import treści (content:import) i leniwe "wersja 1" dla kursów
// sprzed silnika (schemaVersion 1: bloki bez id, id nadawane deterministycznie jako b<indeks>).
model CourseVersion {
  id            String   @id @default(cuid())
  courseId      String
  // Kolejny numer w obrębie kursu (1, 2, ...).
  version       Int
  // 1 = format sprzed silnika scen (bloki bez id), 2 = moduł zwalidowany packages/content (bloki z id).
  schemaVersion Int
  // SHA-256 kanonicznego JSON-a treści: identyczna treść nie tworzy nowej wersji (import jest idempotentny).
  contentHash   String   @db.VarChar(80)
  contentBlocks Json
  blockCount    Int
  createdAt     DateTime @default(now())

  // CASCADE tylko z kursu bez przypisań: przypisanie ma RESTRICT na kurs i na wersję (B-032), więc nie da się skasować
  // kursu z czyimkolwiek wynikiem.
  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments CourseAssignment[]

  @@unique([courseId, version])
  @@unique([courseId, contentHash])
  @@map("course_versions")
}

model CourseAssignment {
  id                String           @id @default(cuid())
  organizationId    String
  userId            String
  courseId          String
  status            AssignmentStatus @default(NOT_STARTED)
  // Czy TO przypisanie liczy się do zgodności/terminu (dashboard, zakładka "Obowiązkowe") - PER PRZYPISANIE, nie
  // pochodna course.mandatory: ten sam kurs może być samodzielnym (zawsze false, CoursesService.selfAssign) albo
  // ręcznym przypisaniem admina (domyślnie course.mandatory, następny PR) dla różnych pracowników jednocześnie.
  // Twórca przypisania ustawia to pole jawnie; backfill istniejących wierszy - migracja 20260922180000.
  mandatory         Boolean          @default(false)
  // Indeks pierwszego nieukończonego bloku - gdzie wznowić kurs.
  currentBlockIndex Int              @default(0)
  // Nowy format (v: 2): { v: 2, blocks: { [blockId]: { type, done, points?, correct?, weight, attempts?, ... } }, notes: string[] }.
  // Format sprzed silnika (bez `v`): { [blockIndex]: { type, answer?, correct?, answeredAt } } - CZYTELNY (CoursesService
  // przelicza go w locie: indeks i -> blockId "b<i>"), ale nowe zapisy są zawsze w nowym formacie.
  // Wypełniane wyłącznie po stronie serwera (CoursesService), nigdy z ciała żądania klienta.
  progress          Json?
  // Wersja treści, na której pracownik zaczął kurs (null = jeszcze nie przypięta: pierwszy /start przypina). Zobacz CourseVersion.
  courseVersionId   String?
  score             Int?
  dueDate           DateTime?
  completedAt       DateTime?
  // Pierwsze rozpoczęcie (NOT_STARTED -> IN_PROGRESS w /start) - czas śledztwa na ekranie zamknięcia sprawy (D-089). null =
  // przypisanie rozpoczęte przed tą kolumną albo jeszcze nierozpoczęte (createdAt to data PRZYPISANIA, nie startu).
  startedAt         DateTime?
  createdAt         DateTime         @default(now())
  // Ostatnia zmiana przypisania (postęp, ukończenie) - źródło "ostatniej
  // aktywności" w dashboardzie zarządu (DashboardService.getUsersStatus).
  updatedAt         DateTime         @default(now()) @updatedAt
  // "Rozpocznij od nowa" (D-069, CoursesService.restart): ustawiane WYŁĄCZNIE na starym przypisaniu w momencie
  // powtórki, które od tej chwili jest historią (wynik/XP/odznaki bez zmian) - nigdy nie kasujemy wiersza. null = to
  // jest AKTYWNE przypisanie. Jedno aktywne przypisanie na (organizationId, userId, courseId) wymuszone częściowym
  // unikalnym indeksem (WHERE "archivedAt" IS NULL) z migracji 20260922200000_course_restart - Prisma nie umie
  // wyrazić WHERE w @@unique, więc (tak jak RLS) ta reguła istnieje tylko w SQL migracji, nie w tym schemacie.
  archivedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Złożony FK: użytkownik musi należeć do TEJ SAMEJ organizacji (FK omijają RLS, więc bez tego przypisanie
  // w kontekście organizacji A mogłoby wskazać użytkownika organizacji B).
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction)
  // RESTRICT (B-032): usunięcie kursu/wersji nie może po cichu skasować wyników wszystkich organizacji (audyt zgodności).
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseVersion CourseVersion? @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)

  // Uwaga: userId+courseId NIE jest tu już unikalne (restart tworzy kolejne wiersze) - prawdziwa unikalność
  // (jedno aktywne przypisanie) to częściowy indeks w migracji, patrz komentarz przy archivedAt.
  @@index([userId, courseId])
  @@index([courseVersionId])
  @@index([organizationId])
  @@index([userId])
  @@map("course_assignments")
}
