              "contradiction": {
                "refutedBy": "nagranie.liczba-47",
                "challengeLine": { "text": "…No tak. Wpisałem liczbę, którą podał. Myślałem, że to blokuje atak." },
                "note": { "text": "Karol przyznał: wpisał liczbę podaną przez dzwoniącego.", "kind": "person" }
              }
            },
            { "id": "kod-2", "text": "Telefon cały czas miałem przy sobie." }
          ]
        },
        {
          "id": "wiedza",
          "text": "Co o tobie wiedział?",
          "lines": [
            {
              "id": "wiedza-1",
              "text": "Znał moje imię, dział, nazwisko kierownika. Mówił o nim jak o koledze.",
              "fragment": { "evidence": true, "note": { "text": "Oszust znał dział i kierownika Karola - wiedzę z publicznych źródeł.", "kind": "person" } }
            }
          ]
        },
        {
          "id": "koniec",
          "text": "Jak zakończyła się rozmowa?",
          "lines": [{ "id": "koniec-1", "text": "Kazał zrestartować komputer dopiero po południu i nikomu nie mówić, żeby nie robić zamieszania." }]
        }
