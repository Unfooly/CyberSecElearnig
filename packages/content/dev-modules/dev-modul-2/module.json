            {
              "id": "glos-1",
              "text": "To był jego głos, na sto procent. Ten sam sposób mówienia.",
              "fragment": { "evidence": true, "note": { "text": "Karol rozpoznał głos Pawła. Głos można podrobić - to nie dowód, kto dzwoni.", "kind": "person" } }
            },
            { "id": "glos-2", "text": "Na wyświetlaczu było „IT Helpdesk”, tak jak zawsze." }
          ]
