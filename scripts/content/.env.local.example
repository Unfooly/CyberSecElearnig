# Wzór pliku scripts/content/.env.local (poza gitem: `.env.local` jest w .gitignore). Klucze są TYLKO u autora treści: nigdy w repo, w CI
# ani w kontenerach; aplikacja (api/web) ich nie zna, zna wyłącznie publiczny CONTENT_BASE_URL. Opis: docs/content-pipeline.md (D-060).

# ElevenLabs (model eleven_multilingual_v2, język pl). Klucz to SEKRET.
ELEVENLABS_API_KEY=
# ID głosów (nie sekrety) NIE są tutaj: rola z treści (narration.voice) -> voiceId w commitowanym scripts/content/voices.json (D-082).

# Cloudflare R2 (tryb --storage r2). Token "Object Read & Write" ograniczony do jednego bucketa. Klucz dostępu i sekret to SEKRETY.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Endpoint S3, np. https://<account-id>.r2.cloudflarestorage.com (bez nazwy bucketa: używamy forcePathStyle).
R2_ENDPOINT=
